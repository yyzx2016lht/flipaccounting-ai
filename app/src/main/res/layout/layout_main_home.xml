<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="翻转记账"
                android:textColor="#333333"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textColor="#999999"
                android:textSize="13sp"
                android:background="#E0E0E0"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 1. 顶部状态卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#5C6BC0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="即刻开启记账"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="授予悬浮窗权限后，即可使用翻转记账功能。"
                    android:textColor="#E8EAF6"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestOverlay"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. 授予权限"
                        android:textColor="#FFFFFF"
                        app:rippleColor="#FFFFFF" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="8dp"
                        android:background="#80FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowOverlay"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. 开启悬浮窗"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:rippleColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. 数据与设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="数据与偏好"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Prompt 调试 -->
                <LinearLayout
                    android:id="@+id/btn_prompt_debug"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🛠️   查看当前 Prompt 相关数据源"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        android:rotation="0"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="50dp"
                    android:background="#F5F5F5" />

                <!-- 资产 -->
                <LinearLayout
                    android:id="@+id/btn_manage_assets"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💳   资产账户管理"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        android:rotation="0"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="50dp"
                    android:background="#F5F5F5" />

                <!-- 分类 -->
                <LinearLayout
                    android:id="@+id/btn_manage_categories"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏷️   收支分类管理"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="50dp"
                    android:background="#F5F5F5" />

                <!-- 货币 -->
                <LinearLayout
                    android:id="@+id/btn_manage_currencies"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💱   多币种与汇率"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>
                
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="50dp"
                    android:background="#F5F5F5" />

                 <!-- 白名单 -->
                 <LinearLayout
                    android:id="@+id/btn_manage_whitelist"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🛡️   触发应用白名单"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="50dp"
                    android:background="#F5F5F5" />

                <!-- 翻转灵敏度 -->
                <LinearLayout
                    android:id="@+id/btn_flip_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎛️   翻转灵敏度调节"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="50dp"
                    android:background="#F5F5F5" />

                <!-- 备份 -->
                <LinearLayout
                    android:id="@+id/btn_backup_restore"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💾   备份与恢复"
                        android:textColor="#333333"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#CCCCCC" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. 高级功能开关 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="实验室功能"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_flip_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="启用翻转手势"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="手机扣在桌面上再翻转至正面时自动记账"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="-4dp"
                    android:paddingBottom="8dp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_flip_always"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="全局感应 (无需 Shizuku)"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    app:switchPadding="12dp"
                    android:layout_marginStart="24dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="忽略白名单在所有场景触发。建议调高灵敏度防误触。"
                    android:textColor="#999999"
                    android:textSize="10sp"
                    android:layout_marginTop="-4dp"
                    android:layout_marginStart="24dp"
                    android:paddingBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F5F5F5" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_vibrate_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="弹窗震动反馈"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="翻转成功弹出记账面板时提供触觉震动反馈"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="-4dp"
                    android:paddingBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F5F5F5" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_hide_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="隐身模式"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="在系统最近任务列表(多任务)中隐藏此App"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="-4dp"
                    android:paddingBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F5F5F5" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_show_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="启用 AI 功能"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <!-- AI 识别主入口 -->
                <LinearLayout
                    android:id="@+id/layout_ai_main_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layout_multi_bill_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_show_multi_bill"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp"
                            android:text="开启多账单模式"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:switchPadding="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="一次性输入多条信息。模式开启后，点击识别按钮将应用多账单提示词。"
                            android:textColor="#999999"
                            android:textSize="10sp"
                            android:layout_marginTop="-4dp"
                            android:layout_marginStart="12dp"
                            android:paddingBottom="8dp"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_multi_bill_not_sync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp"
                            android:text="不验证直接批量保存"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            app:switchPadding="12dp"
                            android:layout_marginStart="24dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="多账单识别结果将优先存入本地账单列表，方便后续核对或批量同步。"
                            android:textColor="#999999"
                            android:textSize="10sp"
                            android:layout_marginTop="-4dp"
                            android:layout_marginStart="36dp"
                            android:paddingBottom="8dp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/divider_ai"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F5F5F5"
                    android:visibility="gone" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_show_voice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="在悬浮窗显示 语音 按钮"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <!-- ASR Engine Selection, indented under switch_show_voice -->
                <LinearLayout
                    android:id="@+id/layout_asr_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="识别引擎"
                        android:textColor="#666666"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinner_asr_mode"
                        android:layout_width="140dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_spinner_rounded"
                        android:entries="@array/asr_modes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_asr_model_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="12dp"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <!-- 左侧：设置项标题 -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="模型信息"
                        android:textColor="#666666"
                        android:textSize="14sp" />

                    <!-- 右侧：带有圆角和边框的徽章/按钮容器 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_delete_offline_model"
                        android:layout_width="140dp"
                        android:layout_height="32dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#F4F6F8"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E0E4E8">

                        <!-- 承载水波纹效果的内容区域 -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/tv_asr_model_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="硅基流动"
                                android:textColor="#4CAF50"
                                android:textStyle="bold"
                                android:textSize="11sp" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_show_multi_cur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="显示 多币种 选项"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F5F5F5" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_logging"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="开发者日志"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    app:switchPadding="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_logs"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:text="查看日志内容 ->"
                    android:textSize="12sp"
                    android:textColor="#5C6BC0"
                    android:visibility="gone"
                    android:padding="0dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 高级留存设置 -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_permanent_wakelock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:text="强力唤醒锁 (防杀)"
            android:textColor="#333333"
            android:textSize="13sp"
            app:switchPadding="12dp"
            android:layout_marginStart="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保持CPU唤醒，极度耗电但强制保活传感器。"
            android:textColor="#999999"
            android:textSize="10sp"
            android:layout_marginTop="-4dp"
            android:layout_marginStart="24dp"
            android:paddingBottom="8dp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_shizuku_persistence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:text="Shizuku 终极保活"
            android:textColor="#333333"
            android:textSize="13sp"
            app:switchPadding="12dp"
            android:layout_marginStart="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用Shizuku隐藏API维持服务常驻，无视系统查杀。"
            android:textColor="#999999"
            android:textSize="10sp"
            android:layout_marginTop="-4dp"
            android:layout_marginStart="24dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flip Accounting"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:textColor="#DDDDDD"
            android:textSize="13sp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
